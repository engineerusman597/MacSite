@inject IHeroSlideRepository Slides
@inject SiteContentService Content

<div class="home-banner" id="home">
    <div class="slider" data-slick="@_configOptions">
        @foreach (var slide in _slides)
        {
            <div class="slide">
                <div class="image">
                    <img src="@ContentLinks.SafeUrl(slide.ImageUrl)" alt="@slide.Alt">
                    <div class="caption">
                        @if (_config.ShowCaptions)
                        {
                            <h1>@ContentLinks.InlineText(string.IsNullOrWhiteSpace(slide.Headline) ? _settings.DefaultHeroHeadline : slide.Headline)</h1>
                        }
                        <a href="/portfolio" class="btn btn-secondary">ENTER PORTFOLIO</a>
                    </div>
                </div>
            </div>
        }
    </div>
    <div class="separator">
        <img src="assets/images/separator.svg" alt="">
    </div>
    <div class="container">
        <a class="play-icon" href="@ContentLinks.SafeUrl(_settings.HeroVideoUrl)" aria-label="@_settings.HeroVideoBadgeText">
            <div class="inner">
                <img src="assets/images/play-icon-image.png" class="inner-image" alt="">
            </div>
            <img src="assets/images/play.svg" class="icon" alt="">
            <span class="text">
                <ChimentWatchTextSvg />
            </span>
        </a>
    </div>
</div>

@code {
    private IReadOnlyList<HeroSlide> _slides = [];
    private SiteSettings _settings = new();
    private SectionConfig _config = new();
    private string _configOptions => SiteContentService.SlickOptions(_config);

    protected override async Task OnInitializedAsync()
    {
        _slides = await Slides.GetActiveAsync();
        _settings = await Content.GetSettingsAsync();
        _config = await Content.GetConfigAsync(SectionConfig.Hero);
    }
}
